  "components": [
    {
      "name": "Botón rótulo",
      "kind": "button",
      "refersTo": "button-strap",
      "description": "CTA de compra: segmento amarillo con acción y segmento azul con el precio.",
      "html": "<a class=\"ds-strap-btn\" href=\"#\"><span>Comprar la skill<svg viewBox=\"0 0 16 16\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path d=\"M2 8h11M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></span><b>USD 19</b></a>",
      "css": ":host{--studio:#12141B;--paper:#F2F4F8;--ink:#12141B;--ink-2:#4A5063;--rule:#D5D9E3;--blue:#2A44F5;--yellow:#FFD84D;--live:#D92020;--on-studio:#F2F4F8;--on-studio-2:#A9AEC0;--studio-line:#2A2E3B;--sans:'Bricolage Grotesque',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;--ease:cubic-bezier(.16,1,.3,1)} .ds-strap-btn{display:inline-flex;align-items:stretch;text-decoration:none;font-family:var(--sans);font-weight:800;line-height:1;color:var(--ink);background:var(--yellow);box-shadow:0 10px 24px -14px rgba(0,0,0,.7);transition:transform .2s var(--ease),box-shadow .2s var(--ease)} .ds-strap-btn span{display:flex;align-items:center;padding:.95em 1.2em;font-size:1.08rem;font-stretch:82%} .ds-strap-btn b{display:flex;align-items:center;padding:.95em 1em;background:var(--blue);color:#fff;font-stretch:80%;font-variant-numeric:tabular-nums} .ds-strap-btn svg{margin-left:.55em;transition:transform .2s var(--ease)} .ds-strap-btn:hover{transform:translateY(-2px);box-shadow:0 16px 30px -16px rgba(0,0,0,.8)} .ds-strap-btn:hover svg{transform:translateX(3px)} .ds-strap-btn:active{transform:scale(.98)} .ds-strap-btn:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}"
    },
    {
      "name": "Rótulo de portada",
      "kind": "custom",
      "refersTo": "chyron-headline",
      "description": "Pila de titular azul, subrótulo amarillo y entradilla en papel.",
      "html": "<div class=\"ds-chyron\"><h1>De una idea a un <em>reel listo</em> para publicar.</h1><p class=\"ds-sub\">Tú das el tema. Claude hace el guion, la voz y la animación.</p><p class=\"ds-lead\">Una skill para Claude que te entrega el reel listo para subir.</p></div>",
      "css": ":host{--studio:#12141B;--paper:#F2F4F8;--ink:#12141B;--ink-2:#4A5063;--rule:#D5D9E3;--blue:#2A44F5;--yellow:#FFD84D;--live:#D92020;--on-studio:#F2F4F8;--on-studio-2:#A9AEC0;--studio-line:#2A2E3B;--sans:'Bricolage Grotesque',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;--ease:cubic-bezier(.16,1,.3,1)} .ds-chyron{display:grid;justify-items:start;font-family:var(--sans);background:var(--studio);padding:24px} .ds-chyron h1{margin:0;background:var(--blue);color:#fff;font-weight:800;font-stretch:76%;font-size:3rem;line-height:.92;letter-spacing:-.012em;padding:.16em .3em .18em;box-shadow:0 24px 50px -24px rgba(0,0,0,.8)} .ds-chyron em{font-style:normal;color:var(--yellow)} .ds-sub{margin:0;background:var(--yellow);color:var(--ink);font-weight:700;font-size:1.1rem;line-height:1.3;padding:.5em .75em} .ds-lead{margin:0;background:var(--paper);color:var(--ink-2);font-size:1rem;line-height:1.5;padding:.75em .95em;max-width:56ch}"
    },
    {
      "name": "Rótulo de sección",
      "kind": "custom",
      "refersTo": "section-strap",
      "description": "Cuadro amarillo + bloque azul como encabezado de cada sección.",
      "html": "<h2 class=\"ds-head\"><span class=\"ds-sq\"></span><span class=\"ds-tx\">Así se hace un reel</span></h2>",
      "css": ":host{--studio:#12141B;--paper:#F2F4F8;--ink:#12141B;--ink-2:#4A5063;--rule:#D5D9E3;--blue:#2A44F5;--yellow:#FFD84D;--live:#D92020;--on-studio:#F2F4F8;--on-studio-2:#A9AEC0;--studio-line:#2A2E3B;--sans:'Bricolage Grotesque',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;--ease:cubic-bezier(.16,1,.3,1)} .ds-head{margin:0;display:inline-flex;align-items:stretch;font-family:var(--sans);font-weight:800;font-stretch:78%;font-size:2.4rem;line-height:.98;letter-spacing:-.01em} .ds-sq{flex:none;width:.42em;background:var(--yellow)} .ds-tx{background:var(--blue);color:#fff;padding:.14em .32em .16em}"
    },
