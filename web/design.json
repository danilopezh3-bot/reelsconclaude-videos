      "description": "Barra fija: logo, mosca EN DIRECTO con reloj y botón pequeño.",
      "html": "<nav class=\"ds-bar\"><a class=\"ds-ident\" href=\"#\">Reels con Claude</a><span class=\"ds-onair\"><i></i>EN DIRECTO <span class=\"ds-clock\">21:04</span></span></nav>",
      "css": ":host{--studio:#12141B;--paper:#F2F4F8;--ink:#12141B;--ink-2:#4A5063;--rule:#D5D9E3;--blue:#2A44F5;--yellow:#FFD84D;--live:#D92020;--on-studio:#F2F4F8;--on-studio-2:#A9AEC0;--studio-line:#2A2E3B;--sans:'Bricolage Grotesque',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;--ease:cubic-bezier(.16,1,.3,1)} .ds-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;height:60px;padding:0 16px;background:color-mix(in srgb,var(--studio) 92%,transparent);border-bottom:1px solid var(--studio-line);font-family:var(--sans);color:var(--on-studio)} .ds-ident{text-decoration:none;color:inherit;font-weight:800;font-size:1.2rem;letter-spacing:-.01em} .ds-ident:hover{color:var(--yellow)} .ds-ident:focus-visible{outline:3px solid var(--yellow);outline-offset:3px} .ds-onair{display:inline-flex;align-items:center;gap:8px;font-size:.82rem;font-weight:800;font-stretch:80%;letter-spacing:.06em;color:var(--on-studio-2)} .ds-onair i{width:8px;height:8px;border-radius:50%;background:var(--live)} .ds-clock{font-family:var(--mono);font-weight:500;letter-spacing:0;color:var(--on-studio);font-variant-numeric:tabular-nums}"
