    {
      "name": "Monitor",
      "kind": "custom",
      "refersTo": null,
      "description": "Pantalla 9:16 con el reel, etiqueta REEL, cifra en bloque azul y play.",
      "html": "<button class=\"ds-mon\" type=\"button\"><span class=\"ds-tag\">REEL</span><span class=\"ds-vw\"><b>1,4 M</b><small>reproducciones</small></span><span class=\"ds-play\">&#9654;</span></button>",
      "css": ":host{--studio:#12141B;--paper:#F2F4F8;--ink:#12141B;--ink-2:#4A5063;--rule:#D5D9E3;--blue:#2A44F5;--yellow:#FFD84D;--live:#D92020;--on-studio:#F2F4F8;--on-studio-2:#A9AEC0;--studio-line:#2A2E3B;--sans:'Bricolage Grotesque',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace;--ease:cubic-bezier(.16,1,.3,1)} .ds-mon{position:relative;width:180px;aspect-ratio:9/16;border:0;padding:0;background:#000;cursor:pointer;font-family:var(--sans);overflow:hidden} .ds-mon::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,0) 40%)} .ds-tag{position:absolute;z-index:1;top:10px;left:10px;background:var(--live);color:#fff;font-weight:800;font-stretch:78%;letter-spacing:.05em;font-size:.72rem;padding:3px 7px} .ds-vw{position:absolute;z-index:1;left:0;top:40px;display:grid} .ds-vw b{background:var(--blue);color:#fff;font-weight:800;font-stretch:78%;font-size:1.6rem;line-height:1;padding:.22em .4em .2em;font-variant-numeric:tabular-nums} .ds-vw small{justify-self:start;background:var(--paper);color:var(--ink);font-weight:800;font-stretch:78%;letter-spacing:.05em;font-size:.7rem;text-transform:uppercase;padding:3px 7px} .ds-play{position:absolute;z-index:1;right:8px;top:6px;width:38px;height:38px;border-radius:50%;background:rgba(18,20,27,.7);display:grid;place-items:center;color:#fff;font-size:12px;transition:background .2s} .ds-mon:hover .ds-play{background:var(--yellow);color:var(--ink)} .ds-mon:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}"
    },
    {
